# Copy this file to .env.local and fill in your key.
# Get a key at https://console.groq.com  -> never commit the real key.
GROQ_API_KEY=your_groq_api_key_here

# Which Groq model the chatbot uses. gpt-oss-20b = fast + cheap (default).
# Swap to openai/gpt-oss-120b for richer answers. See console.groq.com/docs/models.
CHAT_MODEL=openai/gpt-oss-20b
